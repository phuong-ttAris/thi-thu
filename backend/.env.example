# Chuỗi kết nối Postgres (Neon: Dashboard → Connect → copy connection string).
# Đổi sslmode=require thành sslmode=verify-full để pg kiểm tra chứng chỉ đầy đủ (và hết cảnh báo).
DATABASE_URL=postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=verify-full
# Domain frontend được phép gọi API, cách nhau dấu phẩy
CORS_ORIGIN=http://localhost:5173
# Render/Railway tự đặt PORT; khi deploy cần HOST=0.0.0.0
PORT=3100
HOST=127.0.0.1
